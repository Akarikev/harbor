{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harbor",
  "version": "0.1.0",
  "identifier": "io.harbor.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "harbor",
        "width": 400,
        "height": 180,
        "zoomHotkeysEnabled": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "See every dev server on localhost from your tray",
    "longDescription": "harbor is a lightweight Linux tray utility that lists listening TCP ports, shows process metadata, and lets you open, copy, or kill dev servers while protecting system services.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libgtk-layer-shell0"
        ],
        "files": {
          "/usr/share/applications/harbor.desktop": "bundle/linux/harbor.desktop",
          "/etc/xdg/autostart/harbor.desktop": "bundle/linux/harbor-autostart.desktop"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "gtk-layer-shell"
        ],
        "files": {
          "/usr/share/applications/harbor.desktop": "bundle/linux/harbor.desktop",
          "/etc/xdg/autostart/harbor.desktop": "bundle/linux/harbor-autostart.desktop"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/applications/harbor.desktop": "bundle/linux/harbor.desktop"
        }
      }
    }
  }
}
